# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Long random string — generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Store details (shown on site / policy pages) ----
STORE_NAME=Kernel & Co.
STORE_TAGLINE=Honest nuts, seeds & dry fruits — packed fresh in India
SUPPORT_EMAIL=support@yourbrand.in
SUPPORT_PHONE=+91 90000 00000
STORE_FSSAI=
STORE_GSTIN=

# ---- Admin account (created on first start) ----
ADMIN_EMAIL=admin@yourbrand.in
ADMIN_PASSWORD=ChangeMe@123

# ---- Razorpay (dashboard.razorpay.com → Account & Settings → API Keys) ----
# Use rzp_test_... keys first; switch to rzp_live_... after KYC/activation.
# Leave blank locally to use the built-in DEMO payment (disabled when NODE_ENV=production).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhooks → add https://yourdomain.in/api/payments/razorpay-webhook with events payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# ---- Shipping & COD rules (in rupees) ----
FREE_SHIPPING_ABOVE=499
SHIPPING_FEE=49
COD_ENABLED=true
COD_MAX_ORDER=5000
